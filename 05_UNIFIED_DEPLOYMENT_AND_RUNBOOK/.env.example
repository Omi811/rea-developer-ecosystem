# ==============================================================================
# Unified Autonomous AI Engineering Stack - Environment Configuration
# ==============================================================================

# Global Settings
NODE_ENV=production
LOG_LEVEL=info

# 01. ReUI Component Registry
REUI_PORT=3001
REUI_REGISTRY_BASE_URL=http://localhost:3001/r

# 02. Google Lighthouse Auditing Service
LIGHTHOUSE_PORT=8081
CHROME_PATH=/usr/bin/chromium
LIGHTHOUSE_MAX_CONCURRENT_AUDITS=4

# 03. Context7 Documentation Intelligence Engine
CONTEXT7_PORT=4001
REDIS_URL=redis://localhost:6380
DOCS_CACHE_TTL_SECONDS=86400

# 04. Infimium Local Repository Intelligence & Memory
INFIMIUM_PORT=9090
INFIMIUM_STORAGE_DIR=/var/lib/infimium/data
INFIMIUM_STRICT_LOCAL_ONLY=true
