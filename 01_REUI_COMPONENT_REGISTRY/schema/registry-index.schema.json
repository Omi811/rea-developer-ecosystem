{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegistryIndex",
  "description": "Catalog Index of available items in the ReUI registry",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "type", "description"],
    "properties": {
      "name": { "type": "string" },
      "type": {
        "type": "string",
        "enum": ["registry:ui", "registry:block", "registry:hook", "registry:lib", "registry:theme"]
      },
      "description": { "type": "string" },
      "category": { "type": "string" },
      "dependencies": {
        "type": "array",
        "items": { "type": "string" }
      },
      "registryDependencies": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
