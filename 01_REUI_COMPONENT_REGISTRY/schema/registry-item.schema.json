{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegistryItem",
  "description": "Standard shadcn and ReUI Component Registry Item Schema",
  "type": "object",
  "required": ["name", "type", "files"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique identifier for the component or block"
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:block",
        "registry:hook",
        "registry:lib",
        "registry:theme"
      ]
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "devDependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "registryDependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content", "type"],
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["registry:ui", "registry:component", "registry:hook", "registry:lib"]
          },
          "target": { "type": "string" }
        }
      }
    },
    "tailwind": {
      "type": "object",
      "properties": {
        "config": { "type": "object" }
      }
    },
    "cssVars": {
      "type": "object",
      "properties": {
        "light": { "type": "object" },
        "dark": { "type": "object" }
      }
    }
  }
}
